<Window x:Class="FinancialManagment.Views.InstallmentPaidPopUp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinancialManagment.Views"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="InstallmentPaidPopUp" Height="150" Width="750">

    <Window.Resources>

        <!-- Labels -->
        <Style x:Key="LabelsStyle" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Text Box -->
        <Style x:Key="TextBoxesStyle" TargetType="TextBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#FF0C0B0B"/>
            <Setter Property="BorderBrush" Value="#FF1D1C1C"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="ButtonsStyle" TargetType="Button">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontFamily" Value="Bahnschrift SemiLight SemiCondensed"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5 5"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF1D1C1C"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF121111"/>
                </Trigger>
            </Style.Triggers>
        </Style>


    </Window.Resources>

    <Grid Background="#FF151515">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Orientation="Horizontal" Grid.Column="0" HorizontalAlignment="Center">
            <StackPanel>
                <Label Style="{StaticResource LabelsStyle}">Data</Label>
                <TextBox Style="{StaticResource TextBoxesStyle}" Margin="5">20/02/2025</TextBox>
            </StackPanel >
            <StackPanel>
                <Label Style="{StaticResource LabelsStyle}">Valor pago</Label>
                <TextBox Style="{StaticResource TextBoxesStyle}" Margin="5">R$ 100,00</TextBox>
            </StackPanel>
            <StackPanel>
                <Label Style="{StaticResource LabelsStyle}">Pago</Label>
                <CheckBox BorderThickness="0.5" Margin="0 15" HorizontalAlignment="Center">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="2" ScaleY="2" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Height="60"  Margin="0 20 10 0">
            <Button Style="{StaticResource ButtonsStyle}" >Salvar</Button>
            <Button Style="{StaticResource ButtonsStyle}" Width="110">Cancelar</Button>
        </StackPanel>
    </Grid>
</Window>
