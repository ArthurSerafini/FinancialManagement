<UserControl x:Class="FinancialManagment.Views.TablesViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FinancialManagment.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080">

    <UserControl.Resources>

        <!-- Buttons -->
        <Style x:Key="ButtonsTable" TargetType="Button">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontFamily" Value="Bahnschrift SemiLight SemiCondensed"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5 5"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF1D1C1C"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF121111"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small Buttons -->
        <Style x:Key="FunctionButtons" TargetType="Button">
            <Setter Property="FontSize" Value="35"/>
            <Setter Property="FontFamily" Value="Bahnschrift SemiLight SemiCondensed"/>
            <Setter Property="Margin" Value="2 2"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF1D1C1C"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderThickness="3" BorderBrush="#FF0C0B0B">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF279A43"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- List View -->
        <Style x:Key="ListViewTables" TargetType="ListView">
            <Setter Property="Background" Value="#FF0C0B0B"/>
            <Setter Property="BorderBrush" Value="#FF0C0B0B"/>
            <Setter Property="Height" Value="600"/>
            <!--
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/> -->
        </Style>


        <!-- List View Items -->
        <Style x:Key="ListViewsItems" TargetType="ListViewItem">
            <Setter Property="Height" Value="100"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF1D1C1C"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF121111"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </UserControl.Resources>

    <Grid Background="#FF151515">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Label FontSize="25" HorizontalAlignment="Center" Foreground="White">A pagar</Label>
        <Rectangle Fill="#FF0C0B0B" Width="250" Margin="50"/>
        <StackPanel Width="250" Grid.Column="0" Margin="50">
            <ListView x:Name="paymentTable" Style="{StaticResource ListViewTables}"  ItemContainerStyle="{StaticResource ListViewsItems}">
                    <ListViewItem>Item1</ListViewItem>
                    <ListViewItem>Item2</ListViewItem>
                    <ListViewItem>Item3</ListViewItem>
                </ListView>
        </StackPanel>
        <StackPanel Margin="10 50 50 0" Width="50" HorizontalAlignment="Right">
            <Button x:Name="addTaskBtn" Style="{StaticResource FunctionButtons}" Click="addTaskBtn_Click">+</Button>
            <Button Style="{StaticResource FunctionButtons}">-</Button>
            <Button Style="{StaticResource FunctionButtons}">
                <StackPanel>
                    <Image Source="../Icons/edit-icon.png" Width="20"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Label FontSize="25" HorizontalAlignment="Center" Foreground="White" Grid.Column="1">Pago</Label>
        <Rectangle Fill="#FF0C0B0B" Width="250" Margin="50" Grid.Column="1"/>
        <StackPanel Width="250" Grid.Column="1" Margin="50">
            <Button Style="{StaticResource ButtonsTable}">Ola</Button>
        </StackPanel>

    </Grid>
    
</UserControl>
