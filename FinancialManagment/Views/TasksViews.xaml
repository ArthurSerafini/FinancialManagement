<UserControl x:Class="FinancialManagment.Views.TasksViews"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FinancialManagment.Views"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1080">
    <UserControl.Resources>

        <!-- Labels -->
        <Style x:Key="LabelsStyle" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Text Box -->
        <Style x:Key="TextBoxesStyle" TargetType="TextBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#FF0C0B0B"/>
            <Setter Property="BorderBrush" Value="#FF1D1C1C"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="ButtonsTask" TargetType="Button">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontFamily" Value="Bahnschrift SemiLight SemiCondensed"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5 5"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF1D1C1C"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF121111"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- List View -->
        <Style x:Key="ListViewTables" TargetType="ListView">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="360"/>
            <Setter Property="Background" Value="#FF0C0B0B"/>
            <Setter Property="BorderBrush" Value="#FF1D1C1C"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="30 10 30 0"/>
            <Setter Property="Padding" Value="0 10"/>
        </Style>


        <!-- List View Items -->
        <Style x:Key="ListViewsItems" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF1D1C1C"/>
            <Setter Property="Margin" Value="10 2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF121111"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </UserControl.Resources>

    <StackPanel Background="#FF151515">
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="TitleBox"
                     Height="40" 
                     Width="700" 
                     FontSize="30" 
                     VerticalAlignment="Top" 
                     Foreground="White" 
                     Background="Transparent" 
                     BorderBrush="Transparent" 
                     Margin="40 10" 
                     Text="Título"/>
            <Button x:Name="NewBtn" Style="{StaticResource ButtonsTask}" Click="NewBtn_Click">Salvar</Button>
            <Button Style="{StaticResource ButtonsTask}" Width="120">Cancelar</Button>
        </StackPanel>
        
        <Grid Background="#FF151515">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="700"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- COLUMN 0 -->
            <StackPanel>
                <Label Style="{StaticResource LabelsStyle}" Margin="40 20 40 0">Descrição</Label>
                <TextBox x:Name="DescriptionBox"
                         Height="150" 
                         Margin="40 10" 
                         Background="#FF0C0B0B" 
                         FontSize="15" 
                         Foreground="White" 
                         Padding="10"
                         BorderBrush="#FF1D1C1C"
                         BorderThickness="2"
                         ></TextBox>
                
                <Label Style="{StaticResource LabelsStyle}" Margin="40 10 40 0">Parcelas</Label>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="InstallmentsPaidBox" Style="{StaticResource TextBoxesStyle}" Margin="40 0 10 0" Width="70"></TextBox>
                    <Label Style="{StaticResource LabelsStyle}" Margin="5 10">de</Label>
                    <TextBox x:Name="InstallmentsTotalBox" Style="{StaticResource TextBoxesStyle}" Margin="10 0" Width="70"></TextBox>
                </StackPanel>
                

                <Label Style="{StaticResource LabelsStyle}" Margin="40 20 40 0">Valor Pago</Label>
                <TextBox x:Name="PaidValueBox" 
                         Style="{StaticResource TextBoxesStyle}" 
                         Margin="40 0"
                         LostFocus="PaidValueBox_LostFocus"
                         />

                <Label Style="{StaticResource LabelsStyle}" Margin="40 20 40 0">Valor Total</Label>
                <TextBox x:Name="TotalValueBox" 
                         Style="{StaticResource TextBoxesStyle}" 
                         Margin="40 0" 
                         FontWeight="Bold"
                         LostFocus="TotalValueBox_LostFocus"
                         ></TextBox>
            </StackPanel>

            <!-- COLUMN 1 -->
            <StackPanel Grid.Column="1">
                <Label Style="{StaticResource LabelsStyle}" Margin="60 20 60 0">Datas de Pagamento</Label>
                <ListView x:Name="paymentTable" Style="{StaticResource ListViewTables}"  ItemContainerStyle="{StaticResource ListViewsItems}">
                    <ListViewItem>25/02/2025</ListViewItem>
                    <ListViewItem>25/03/2025</ListViewItem>
                    <ListViewItem>25/04/2025</ListViewItem>
                </ListView>

                <Label Style="{StaticResource LabelsStyle}" Margin="60 20 60 0">Data final</Label>
                <TextBox Style="{StaticResource TextBoxesStyle}" FontWeight="Bold" Margin="65 10">25/04/2025</TextBox>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
