<Window x:Class="FinancialManagment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FinancialManagment"
        xmlns:views="clr-namespace:FinancialManagment.Views"
    mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280">
    <Window.Resources>

        <DataTemplate x:Name="tablesViewTemplate" DataType="{x:Type views:TablesViews}">
            <views:TablesViews DataContext="{Binding}"/>
        </DataTemplate>

        <DataTemplate x:Name="page2ViewTemplate" DataType="{x:Type views:Page2}">
            <views:Page2 DataContext="{Binding}"/>
        </DataTemplate>

        <DataTemplate x:Name="tasksViewTemplate" DataType="{x:Type views:TasksViews}">
            <views:TasksViews DataContext="{Binding}"/>
        </DataTemplate>

        <Style x:Key="MenuButtons" TargetType="Button">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="FontFamily" Value="Bahnschrift SemiLight SemiCondensed"/>
            <Setter Property="Margin" Value="30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="DarkKhaki"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
            
        </Style>

    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Rectangle Fill="#FF1D1C1C"></Rectangle>

        <StackPanel Margin="10 100" VerticalAlignment="Top">
            <Button x:Name="MenuTableBtn" Click="MenuTableBtn_Click" Style="{StaticResource MenuButtons}" Content="Tabelas"></Button>
            <Button x:Name="MenuPage2Btn" Click="MenuPage2Btn_Click" Style="{StaticResource MenuButtons}" Content="Testes"></Button>
        </StackPanel>

        <ContentControl Grid.Column="1" Content="{Binding}">
            
        </ContentControl>
        
    </Grid>
</Window>
